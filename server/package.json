{
  "name": "clinic-server",
  "version": "2.0.0",
  "description": "Hospital / OPD clinic management system backend (PostgreSQL + Prisma)",
  "type": "module",
  "main": "src/index.js",
  "prisma": {
    "seed": "node src/utils/seed.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/utils/seed.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
